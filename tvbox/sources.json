{
  "$comment": "唯一维护入口。改源只改这里，其余产物由 build.py 自动生成。",
  "meta": {
    "name": "Joe TV",
    "owner": "josephgg",
    "repo": "source",
    "subdir": "tvbox",
    "branch": "main",
    "pages_base": "https://josephgg.github.io/source/tvbox/",
    "cdn": [
      "https://fastly.jsdelivr.net/gh/josephgg/source@main/tvbox/",
      "https://cdn.jsdelivr.net/gh/josephgg/source@main/tvbox/"
    ],
    "index_base": "cdn",
    "mirrors": [
      "https://gh-proxy.com/",
      "https://ghfast.top/",
      "https://ghproxy.net/",
      "https://gh.llkk.cc/"
    ]
  },
  "build": {
    "merge_lives": true,
    "max_lives": 12,
    "merge_ads": false,
    "merge_flags": true,
    "max_parses": 36,
    "name_prefix": true,
    "emit_source_repo": true,
    "min_retain_ratio": 0.85,
    "lite_size": 72,
    "probe_spider": true,
    "probe_timeout": 10,
    "probe_cms": true,
    "cms_timeout": 12,
    "lite_per_source": 5,
    "$override_comment": "固定输出值，覆盖各源自带的 notice/wallpaper/logo/name。留空字符串等于删掉该字段。图片放 tvbox/assets/ 时必须写完整 CDN 地址——相对路径会按源站解析，指不到本仓。",
    "override": {
      "name": "Joe TV",
      "notice": "重要的事，值得慢慢做。",
      "wallpaper": "https://fastly.jsdelivr.net/gh/josephgg/source@main/tvbox/assets/wallpaper.webp"
    }
  },
